%% reward-bench — Erlang/OTP build config per SOLUTION-ARCHITECTURE.md.

{erl_opts, [debug_info,
            warnings_as_errors,
            warn_unused_vars,
            warn_shadow_vars,
            warn_unused_import,
            warn_unused_function,
            warn_export_vars,
            warn_obsolete_guard]}.

{deps, [
    {hackney, "1.20.1"},
    {jsx,     "3.1.0"}
]}.

{shell, [
    {apps, [reward_bench]}
]}.

{relx, [
    {release, {reward_bench, "0.1.0"}, [reward_bench]},
    {mode, prod}
]}.

{profiles, [
    {prod, [{relx, [{mode, prod}, {dev_mode, false}, {include_erts, true}]}]},
    {test, [{erl_opts, [nowarn_export_all]},
            {deps, [{proper, "1.4.0"}]}]}
]}.
