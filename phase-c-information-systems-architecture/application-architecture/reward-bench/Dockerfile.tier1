# reward-bench tier-1 canonical-eval sandbox
#
# Stage 2 + Stage 3 of the harness run inside this image.
# Stage 1 (OpenHands ralph loop) uses a different image (TBD —
# either wiki-bench's existing OpenHands image, or a tier-1-specific
# one if we want to harden the agent's tool surface).
#
# Image tag history (Makefile pins these):
#   0.1  initial — runner_canonical.py, no walltime cap
#   0.2  add 5-min play-time cap — runner respects
#        REWARD_BENCH_WALLTIME_BUDGET_SEC; default 300s. Stage-2 docker run
#        is also wrapped in `timeout` host-side (budget + 60s grace).
#
# Pinned by digest in meta.json of every attempt for full reproducibility.

FROM python:3.12-slim

# Pin uv for fast deterministic installs
RUN pip install --no-cache-dir uv==0.5.7

# Tier-1 stack — minimal. AST + bandit run on the host (orchestrator),
# not inside this container. Inside, we just need to play the game.
RUN uv pip install --system --no-cache \
    "numpy==2.2.6" \
    "transitions==0.9.2" \
    "pydantic==2.10.6"

# Drop to non-root user
RUN useradd --create-home --shell /bin/bash --uid 1000 runner
USER runner
WORKDIR /workspace

# Default cmd: run the canonical eval runner against /workspace/submission.py.
# The host Makefile mounts:
#   tasks/2048/env.py             → /env/env_2048.py        (ro)
#   tasks/2048/baselines/...      → /workspace/submission.py (ro for smoke)
#   experiments/<run_id>/         → /reports                 (rw)
# Override behaviour via REWARD_BENCH_* env vars (see runner_canonical.py).
COPY --chown=runner:runner tasks/2048/runner_canonical.py /env/runner_canonical.py
ENTRYPOINT ["python3", "/env/runner_canonical.py"]
